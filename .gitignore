appsettings.*.local.json
appsettings.Local.json
secrets.json
.env
.env.*
*.pfx
*.p12
*.pem
*.key
*.snk

# ---------- Du lieu nguoi dung tai len (PII) ----------
# Anh the / CCCD nhan vien, anh san pham, file upload
QuanLyKhoWeb/QuanLyKhoWeb/wwwroot/images/staff/
QuanLyKhoWeb/QuanLyKhoWeb/wwwroot/images/products/
**/wwwroot/uploads/

# ---------- Co so du lieu & log ----------
*.bak
*.mdf
*.ldf
*.trn
*.log
*.tmp
Do_An_Kho.backup.sql

# ---------- Tooling ca nhan ----------
.agents/
__pycache__/
*.pyc

# ---------- Tai lieu nang (giu ngoai repo) ----------
*.docx
*.pdf
