@model QuanLyKhoWeb.Models.Entities.KhuyenMai
@{
    ViewData["Title"] = "Chi tiết khuyến mãi";
    var duocTao = (User.FindFirst("VaiTro")?.Value ?? "") != "Nhân viên giao hàng";
    var phanTram = Model.SoLanSuDungToiDa.HasValue && Model.SoLanSuDungToiDa > 0
        ? Math.Min(100, (int)Math.Round(Model.SoLanDaDung * 100.0 / Model.SoLanSuDungToiDa.Value)) : 0;
}
<div class="page-header">
    <div>
        <h3 class="app-page-title"><i class="bi bi-ticket-perforated me-2 text-primary"></i>Mã @Model.MaCodeKhuyenMai</h3>
        <p class="page-subtitle">@Model.TenKhuyenMai</p>
    </div>
    <div class="d-flex gap-2 align-items-start">
        @if (Model.TrangThaiHoatDong == true) { <span class="badge bg-success">Đang chạy</span> } else { <span class="badge bg-secondary">Tắt</span> }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
        @if (duocTao)
        {
            <a asp-action="Edit" asp-route-id="@Model.MaKhuyenMai" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil me-1"></i>Sửa</a>
            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#xoaKm"><i class="bi bi-trash me-1"></i>Xóa</button>
        }
    </div>
</div>
<div class="app-card">
    <h6 class="section-title"><i class="bi bi-ticket-detailed"></i>Điều kiện áp dụng</h6>
    <dl class="detail-list">
        <div class="detail-row"><dt class="dl-label"><i class="bi bi-tag"></i>Tên</dt><dd class="mb-0">@Model.TenKhuyenMai</dd></div>
        <div class="detail-row"><dt class="dl-label"><i class="bi bi-percent"></i>Loại</dt><dd class="mb-0">@(Model.LoaiGiamGia == "PERCENT" ? "Giảm % đơn hàng" : "Giảm tiền cố định")</dd></div>
        <div class="detail-row"><dt class="dl-label"><i class="bi bi-cash-coin"></i>Giá trị</dt><dd class="mb-0 fw-bold">@(Model.LoaiGiamGia == "PERCENT" ? Model.GiaTriGiam + "%" : Model.GiaTriGiam.ToString("N0") + "đ")</dd></div>
        <div class="detail-row"><dt class="dl-label"><i class="bi bi-cart-check"></i>Đơn tối thiểu</dt><dd class="mb-0">@((Model.GiaTriDonToiThieu ?? 0).ToString("N0")) đ</dd></div>
        <div class="detail-row">
            <dt class="dl-label"><i class="bi bi-graph-up"></i>Đã dùng / Giới hạn</dt>
            <dd class="mb-0">
                @Model.SoLanDaDung / @(Model.SoLanSuDungToiDa?.ToString() ?? "Không giới hạn")
                @if (Model.SoLanSuDungToiDa.HasValue)
                {
                    <div class="progress mt-1" style="height:6px;max-width:220px"><div class="progress-bar bg-primary" style="width:@(phanTram)%"></div></div>
                }
            </dd>
        </div>
        <div class="detail-row"><dt class="dl-label"><i class="bi bi-calendar-range"></i>Hiệu lực</dt><dd class="mb-0">@Model.NgayBatDau.ToString("dd/MM/yyyy") — @Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd></div>
    </dl>
</div>

<!-- Popup xác nhận xóa mã (chặn khi đã có đơn dùng mã) -->
<div class="modal fade" id="xoaKm" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h6 class="modal-title">Xóa mã @Model.MaCodeKhuyenMai?</h6><button class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <form asp-action="Xoa" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MaKhuyenMai" />
            <div class="modal-body">
                <p class="mb-0">Bạn có chắc muốn xóa mã <b>@Model.MaCodeKhuyenMai</b>?</p>
                <p class="text-warning mt-1 mb-0"><i class="bi bi-exclamation-triangle me-1"></i>Không xóa được nếu đã có đơn hàng dùng mã này.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            </div>
        </form>
    </div></div>
</div>
