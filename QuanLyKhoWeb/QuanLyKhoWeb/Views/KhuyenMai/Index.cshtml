@model List<QuanLyKhoWeb.Models.Entities.KhuyenMai>
@{
    ViewData["Title"] = "Khuyến mãi";
    ViewData["Subtitle"] = "Mã giảm giá đơn hàng";
    var duocTao = QuanLyKhoWeb.Authorization.QuyenNguoiDung.SuaKhuyenMai(User);
    int trang = ViewBag.Trang ?? 1;
    int totalPage = ViewBag.TotalPage ?? 1;
    int total = ViewBag.Total ?? Model.Count;
}
<div class="page-header">
    <div>
        <h1 class="app-page-title"><i class="bi bi-ticket-perforated"></i>Khuyến mãi</h1>
        <p class="page-subtitle">Mã giảm theo phần trăm hoặc số tiền cố định, kèm giới hạn lượt dùng và thời gian hiệu lực.</p>
    </div>
    @if (duocTao) { <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i>Tạo mã khuyến mãi</a> }
</div>

<div class="app-card mb-3">
    <h6 class="section-title"><i class="bi bi-search"></i>Tìm mã khuyến mãi</h6>
    <partial name="_OTimKiem" model="@(new QuanLyKhoWeb.Models.ViewModels.OTimKiemVm {
        Trang = "khuyenmai",
        Controller = "KhuyenMai",
        GiaTri = ViewData["SearchValue"] as string,
        Placeholder = "Tìm mã code hoặc tên chương trình khuyến mãi…"
    })" />
</div>

<div class="app-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h6 class="section-title mb-0" style="border-left-color:var(--kho-primary)"><i class="bi bi-table"></i>Danh sách mã</h6>
        <span class="cell-sub">@total mã · trang @trang/@totalPage</span>
    </div>
    <div class="table-responsive">
        <table class="table table-app mb-0">
            <thead>
                <tr><th>Mã</th><th>Chương trình</th><th>Giảm</th><th class="num">Đơn tối thiểu</th><th style="min-width:160px">Đã dùng</th><th>Hiệu lực</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var k in Model)
            {
                var phanTram = k.SoLanSuDungToiDa.HasValue && k.SoLanSuDungToiDa > 0
                    ? Math.Min(100, (int)Math.Round(k.SoLanDaDung * 100.0 / k.SoLanSuDungToiDa.Value)) : 0;
                <tr>
                    <td><span class="sku">@k.MaCodeKhuyenMai</span></td>
                    <td class="cell-main">@k.TenKhuyenMai</td>
                    <td class="fw-semibold">@(k.LoaiGiamGia == "PERCENT" ? k.GiaTriGiam + "%" : k.GiaTriGiam.ToString("N0") + " đ")</td>
                    <td class="num">@((k.GiaTriDonToiThieu ?? 0).ToString("N0")) đ</td>
                    <td>
                        <div class="d-flex justify-content-between cell-sub mb-1"><span>@k.SoLanDaDung lượt</span><span>@(k.SoLanSuDungToiDa?.ToString() ?? "∞")</span></div>
                        @if (k.SoLanSuDungToiDa.HasValue)
                        {
                            <div class="progress" style="height:5px"><div class="progress-bar" style="width:@(phanTram)%"></div></div>
                        }
                    </td>
                    <td class="cell-sub">@k.NgayBatDau.ToString("dd/MM/yyyy") – @k.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (k.TrangThaiHoatDong == true) { <span class="badge bg-success badge-dot">Đang chạy</span> }
                        else { <span class="badge bg-secondary badge-dot">Đã tắt</span> }
                    </td>
                    <td>
                        <div class="table-actions">
                            <a asp-action="Details" asp-route-id="@k.MaKhuyenMai" class="btn btn-sm btn-outline-primary" title="Xem chi tiết" aria-label="Xem @k.MaCodeKhuyenMai"><i class="bi bi-eye"></i></a>
                            @if (duocTao)
                            {
                                <a asp-action="Edit" asp-route-id="@k.MaKhuyenMai" class="btn btn-sm btn-outline-secondary" title="Sửa" aria-label="Sửa @k.MaCodeKhuyenMai"><i class="bi bi-pencil"></i></a>
                                <form asp-action="DoiTrangThai" method="post" class="d-inline-flex">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@k.MaKhuyenMai" /><button class="btn btn-sm btn-outline-secondary" title="Bật hoặc tắt mã" aria-label="Bật hoặc tắt @k.MaCodeKhuyenMai"><i class="bi bi-arrow-repeat"></i></button></form>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#xoa-km-@k.MaKhuyenMai" title="Xóa" aria-label="Xóa @k.MaCodeKhuyenMai"><i class="bi bi-trash"></i></button>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8">
                    <div class="empty-state">
                        <i class="bi bi-ticket-perforated"></i>
                        <div>Chưa có mã khuyến mãi nào</div>
                        <p class="page-subtitle mx-auto" style="max-width:42ch">Tạo mã đầu tiên để áp dụng giảm giá cho đơn hàng.</p>
                        @if (duocTao) { <a asp-action="Create" class="btn btn-primary">Tạo mã khuyến mãi</a> }
                    </div>
                </td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<partial name="_PhanTrang" model="@(new QuanLyKhoWeb.Models.ViewModels.PhanTrangVm {
    Trang = trang,
    TotalPage = totalPage,
    Total = total,
    PageSize = 30,
    Nhan = "mã",
    Controller = "KhuyenMai",
    AriaLabel = "Phân trang khuyến mãi",
    ThamSo = new() { ["search"] = Context.Request.Query["search"].ToString() }
})" />

@if (duocTao)
{
    @foreach (var k in Model)
    {
    <div class="modal fade" id="xoa-km-@k.MaKhuyenMai" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content modal-danger">
            <div class="modal-header"><h6 class="modal-title"><i class="bi bi-trash"></i>Xóa mã @k.MaCodeKhuyenMai</h6><button class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <form asp-action="Xoa" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@k.MaKhuyenMai" />
                <div class="modal-body">
                <div class="confirm-record">
                    <i class="bi bi-ticket-perforated"></i>
                    <div>
                        <div class="confirm-record__name">@k.TenKhuyenMai</div>
                        <div class="confirm-record__meta">@k.MaCodeKhuyenMai · @k.SoLanDaDung lượt đã dùng</div>
                    </div>
                </div>
                <p class="mb-2">Bạn sắp xóa chương trình này. Thao tác không thể hoàn tác.</p>
                    <div class="callout callout--warning"><i class="bi bi-exclamation-triangle"></i><span>Không xóa được nếu đã có đơn hàng sử dụng mã này.</span></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">Xóa mã</button>
                </div>
            </form>
        </div></div>
    </div>
    }
}
