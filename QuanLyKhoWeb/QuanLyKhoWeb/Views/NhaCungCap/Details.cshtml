@model QuanLyKhoWeb.Models.Entities.NhaCungCap
@{
    ViewData["Title"] = "Chi tiết nhà cung cấp";
    var duocSua = QuanLyKhoWeb.Authorization.QuyenNguoiDung.SuaNhaCungCap(User);
}
<div class="page-header">
    <div>
        <h1 class="app-page-title"><i class="bi bi-building"></i>@Model.TenNhaCungCap</h1>
        <p class="page-subtitle"><span class="sku">@Model.MaCodeNcc</span></p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        @if (Model.TrangThaiHoatDong == true) { <span class="badge bg-success badge-dot">Đang hợp tác</span> }
        else { <span class="badge bg-secondary badge-dot">Ngừng hợp tác</span> }
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i>Quay lại</a>
        @if (duocSua)
        {
            <a asp-action="Edit" asp-route-id="@Model.MaNhaCungCap" class="btn btn-primary"><i class="bi bi-pencil"></i>Sửa</a>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#xoaNcc"><i class="bi bi-trash"></i>Xóa</button>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="app-card">
            <h6 class="section-title"><i class="bi bi-card-list"></i>Thông tin nhà cung cấp</h6>
            <dl class="detail-list">
                <div class="detail-row"><dt class="dl-label"><i class="bi bi-hash"></i>Mã nhà cung cấp</dt><dd class="mb-0"><span class="sku">@Model.MaCodeNcc</span></dd></div>
                <div class="detail-row"><dt class="dl-label"><i class="bi bi-building"></i>Tên</dt><dd class="mb-0 cell-main">@Model.TenNhaCungCap</dd></div>
                <div class="detail-row"><dt class="dl-label"><i class="bi bi-telephone"></i>Số điện thoại</dt><dd class="mb-0">@(Model.SoDienThoai ?? "—")</dd></div>
                <div class="detail-row"><dt class="dl-label"><i class="bi bi-envelope"></i>Email</dt><dd class="mb-0">@(Model.Email ?? "—")</dd></div>
                <div class="detail-row"><dt class="dl-label"><i class="bi bi-geo-alt"></i>Địa chỉ</dt><dd class="mb-0">@(Model.DiaChi ?? "—")</dd></div>
            </dl>
        </div>
    </div>
    <div class="col-lg-4 detail-aside">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-receipt"></i></div>
            <div>
                <div class="stat-value">@Model.PhieuNhapKhos.Count</div>
                <div class="stat-label">Phiếu nhập từ đối tác này</div>
            </div>
        </div>
        <div class="app-card mt-3">
            <div class="callout"><i class="bi bi-info-circle"></i><span>Nhà cung cấp đã có phiếu nhập sẽ không thể xóa, nhằm giữ nguyên lịch sử kho.</span></div>
        </div>
    </div>
</div>

@if (duocSua)
{
<div class="modal fade" id="xoaNcc" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content modal-danger">
        <div class="modal-header"><h6 class="modal-title"><i class="bi bi-trash"></i>Xóa nhà cung cấp @Model.MaCodeNcc</h6><button class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <form asp-action="Xoa" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MaNhaCungCap" />
            <div class="modal-body">
                <div class="confirm-record">
                    <i class="bi bi-building"></i>
                    <div>
                        <div class="confirm-record__name">@Model.TenNhaCungCap</div>
                        <div class="confirm-record__meta">@Model.MaCodeNcc · @Model.PhieuNhapKhos.Count phiếu nhập</div>
                    </div>
                </div>
                <p class="mb-2">Bạn sắp xóa nhà cung cấp này. Thao tác không thể hoàn tác.</p>
                <div class="callout callout--warning"><i class="bi bi-exclamation-triangle"></i><span>Chỉ xóa được nhà cung cấp chưa có phiếu nhập kho nào.</span></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-danger">Xóa nhà cung cấp</button>
            </div>
        </form>
    </div></div>
</div>
}
