@model QuanLyKhoWeb.Models.Entities.NhaCungCap
@{
    ViewData["Title"] = "Chi tiết nhà cung cấp";
}
<div class="page-header">
    <div>
        <h3 class="app-page-title"><i class="bi bi-building me-2 text-primary"></i>@Model.TenNhaCungCap</h3>
        <p class="page-subtitle">@Model.MaCodeNcc</p>
    </div>
    <div class="d-flex gap-2 align-items-start flex-wrap">
        @if (Model.TrangThaiHoatDong == true) { <span class="badge bg-success">Đang hợp tác</span> } else { <span class="badge bg-secondary">Ngừng hợp tác</span> }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
        <a asp-action="Edit" asp-route-id="@Model.MaNhaCungCap" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil me-1"></i>Sửa</a>
    </div>
</div>
<div class="app-card" style="max-width:640px">
    <h6 class="section-title"><i class="bi bi-card-list"></i>Thông tin nhà cung cấp</h6>
    <dl class="detail-list">
        <div class="detail-row"><dt class="dl-label"><i class="bi bi-hash"></i>Mã NCC</dt><dd class="mb-0 fw-bold text-primary">@Model.MaCodeNcc</dd></div>
        <div class="detail-row"><dt class="dl-label"><i class="bi bi-building"></i>Tên</dt><dd class="mb-0">@Model.TenNhaCungCap</dd></div>
        <div class="detail-row"><dt class="dl-label"><i class="bi bi-telephone"></i>Số điện thoại</dt><dd class="mb-0">@(Model.SoDienThoai ?? "—")</dd></div>
        <div class="detail-row"><dt class="dl-label"><i class="bi bi-envelope"></i>Email</dt><dd class="mb-0">@(Model.Email ?? "—")</dd></div>
        <div class="detail-row"><dt class="dl-label"><i class="bi bi-geo-alt"></i>Địa chỉ</dt><dd class="mb-0">@(Model.DiaChi ?? "—")</dd></div>
        <div class="detail-row"><dt class="dl-label"><i class="bi bi-receipt"></i>Số phiếu nhập</dt><dd class="mb-0 fw-bold">@Model.PhieuNhapKhos.Count</dd></div>
    </dl>
</div>
