@model QuanLyKhoWeb.Models.Entities.NhaCungCap
@{
    ViewData["Title"] = "Sửa nhà cung cấp";
}
<div class="page-header">
    <div><h3 class="app-page-title"><i class="bi bi-pencil me-2 text-primary"></i>Sửa @Model.MaCodeNcc</h3><p class="page-subtitle">@Model.TenNhaCungCap</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
</div>
<div class="app-card" style="max-width:640px">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.MaNhaCungCap" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Mã nhà cung cấp</label>
                <input class="form-control" value="@Model.MaCodeNcc" readonly />
                <div class="form-hint">Mã tự sinh, không được sửa.</div>
            </div>
            <div class="col-md-6">
                <label asp-for="TenNhaCungCap" class="form-label required">Tên nhà cung cấp</label>
                <input asp-for="TenNhaCungCap" class="form-control" pattern="[^0-9]*" title="Tên nhà cung cấp không được chứa số" />
                <span asp-validation-for="TenNhaCungCap" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="VD: lienhe@anphat.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SoDienThoai" class="form-label">Số điện thoại</label>
                <input asp-for="SoDienThoai" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="TrangThaiHoatDong" class="form-label">Trạng thái</label>
                <select asp-for="TrangThaiHoatDong" class="form-select">
                    <option value="true">Đang hợp tác</option>
                    <option value="false">Ngừng hợp tác</option>
                </select>
            </div>
            <div class="col-12">
                <label asp-for="DiaChi" class="form-label">Địa chỉ</label>
                <input asp-for="DiaChi" class="form-control" />
            </div>
        </div>
        <div class="mt-3 d-flex gap-2"><button class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Lưu thay đổi</button><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
