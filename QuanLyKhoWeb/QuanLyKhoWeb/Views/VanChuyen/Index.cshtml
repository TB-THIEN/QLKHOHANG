@model List<QuanLyKhoWeb.Models.Entities.VanDon>
@{
    ViewData["Title"] = "Vận chuyển";
    ViewData["Subtitle"] = "Vận đơn tự tạo từ đơn giao hàng";
    var nvList = ViewBag.NvGiaoHang as List<QuanLyKhoWeb.Models.Entities.NguoiDung> ?? new();
    var vaiTro = User.FindFirst("VaiTro")?.Value ?? "";
    var duocTao = vaiTro != "Nhân viên giao hàng";
    var duocXacNhan = vaiTro == "Quản lý" || vaiTro == "Nhân viên giao hàng" || vaiTro == "Nhân viên bán hàng";
}
<div class="page-header">
    <div><h3 class="app-page-title"><i class="bi bi-truck me-2 text-primary"></i>Vận chuyển</h3><p class="page-subtitle">Theo dõi chưa hoàn thành, chưa giao, đã giao</p></div>
</div>

<!-- Chỉ giữ lọc thời gian + Nhân viên giao (bỏ kết nối VC, lọc khu vực/chi nhánh) -->
<div class="app-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label">Từ ngày</label><input type="date" name="tuNgay" value="@ViewBag.TuNgay" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Đến ngày</label><input type="date" name="denNgay" value="@ViewBag.DenNgay" class="form-control" /></div>
        <div class="col-md-3">
            <label class="form-label">Nhân viên giao</label>
            <select name="maNvGiao" class="form-select">
                <option value="">-- Tất cả --</option>
                @foreach (var nv in nvList)
                {
                    @if (ViewBag.MaNvGiao == nv.MaNguoiDung)
                    { <option value="@nv.MaNguoiDung" selected>@nv.HoTen</option> }
                    else
                    { <option value="@nv.MaNguoiDung">@nv.HoTen</option> }
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2"><button class="btn btn-outline-primary"><i class="bi bi-search me-1"></i>Lọc</button><a asp-action="Index" class="btn btn-outline-secondary">Xóa</a></div>
    </form>
</div>

<div class="app-card">
    <div class="table-responsive">
        <table class="table table-app table-hover mb-0">
            <thead><tr><th>Mã đơn hàng</th><th>Tên hàng</th><th class="num">Số lượng</th><th>Họ tên khách hàng</th><th>Nhân viên giao</th><th>Trạng thái</th><th>Chức năng</th></tr></thead>
            <tbody>
            @foreach (var v in Model)
            {
                var tenHang = string.Join(", ", v.MaDonHangNavigation.ChiTietDonHangs.Select(c => c.MaSkuNavigation?.MaMauSanPhamNavigation?.TenSanPham));
                if (tenHang.Length > 80) tenHang = tenHang.Substring(0, 80) + "...";
                var tongSl = v.MaDonHangNavigation.ChiTietDonHangs.Sum(c => c.SoLuong);
                <tr>
                    <td class="fw-bold text-primary">@v.MaDonHangNavigation.MaCodeDonHang<br /><small class="text-muted">@v.MaCodeVanDon</small></td>
                    <td>@tenHang</td>
                    <td class="num">@tongSl</td>
                    <td>@v.MaDonHangNavigation.TenKhachHangGiao</td>
                    <td>
                        @if (v.MaNhanVienGiaoHangNavigation == null)
                        {
                            <span class="text-muted">—</span>
                        }
                        else
                        {
                            <span class="badge bg-success"><i class="bi bi-person-check me-1"></i>@v.MaNhanVienGiaoHangNavigation.HoTen</span>
                            @if (v.TrangThai != "DA_GIAO")
                            {
                                <a asp-action="GanNhanVien" asp-route-id="@v.MaVanDon" class="btn btn-sm btn-link">đổi</a>
                            }
                        }
                    </td>
                    <td>
                        @if (v.TrangThai == "CHUA_HOAN_THANH")
                        {
                            <a asp-action="GanNhanVien" asp-route-id="@v.MaVanDon" class="btn btn-sm btn-warning"><i class="bi bi-exclamation-circle me-1"></i>Chưa hoàn thành</a>
                        }
                        else if (v.TrangThai == "DA_GIAO") { <span class="badge bg-success">Đã giao</span> }
                        else { <span class="badge bg-warning text-dark">Chưa giao</span> }
                    </td>
                    <td class="d-flex gap-1">
                        <a asp-action="GanNhanVien" asp-route-id="@v.MaVanDon" class="btn btn-sm btn-outline-primary" title="Xem chi tiết đơn"><i class="bi bi-eye"></i></a>
                        @if (duocXacNhan && v.TrangThai == "CHUA_GIAO")
                        {
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#giao-@v.MaVanDon" title="Xác nhận đã giao"><i class="bi bi-check2-circle me-1"></i>Đã giao</button>
                        }
                        @if (duocTao && v.TrangThai == "DA_GIAO")
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#xoa-@v.MaVanDon" title="Xóa vận đơn đã giao"><i class="bi bi-trash"></i></button>
                        }
                    </td>
                </tr>
                @if (duocXacNhan && v.TrangThai == "CHUA_GIAO")
                {
                <!-- Popup xác nhận đã giao: đối chiếu thông tin trước khi chốt -->
                <div class="modal fade" id="giao-@v.MaVanDon" tabindex="-1">
                    <div class="modal-dialog"><div class="modal-content">
                        <div class="modal-header"><h6 class="modal-title"><i class="bi bi-check2-circle text-primary me-2"></i>Xác nhận đã giao @v.MaCodeVanDon?</h6><button class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
                        <div class="modal-body">
                            <dl class="detail-list">
                                <div class="detail-row"><dt class="dl-label">Đơn hàng</dt><dd class="mb-0 fw-bold">@v.MaDonHangNavigation.MaCodeDonHang</dd></div>
                                <div class="detail-row"><dt class="dl-label">Khách</dt><dd class="mb-0">@v.MaDonHangNavigation.TenKhachHangGiao</dd></div>
                                <div class="detail-row"><dt class="dl-label">Số lượng</dt><dd class="mb-0">@tongSl sản phẩm</dd></div>
                                <div class="detail-row"><dt class="dl-label">NV giao</dt><dd class="mb-0">@(v.MaNhanVienGiaoHangNavigation?.HoTen ?? "—")</dd></div>
                            </dl>
                            @if (v.MaNhanVienGiaoHangNavigation == null)
                            {
                                <div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle me-1"></i>Chưa gán nhân viên giao. <a asp-action="GanNhanVien" asp-route-id="@v.MaVanDon">Gán ngay</a> trước khi xác nhận.</div>
                            }
                            else
                            {
                                <p class="text-muted mb-0"><i class="bi bi-info-circle me-1"></i>Xác nhận xong vận đơn khóa ở trạng thái <b>Đã giao</b>, không thay đổi lại được.</p>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Để sau</button>
                            @if (v.MaNhanVienGiaoHangNavigation != null)
                            {
                                <form asp-action="CapNhatTrangThai" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@v.MaVanDon" />
                                    <input type="hidden" name="trangThai" value="DA_GIAO" />
                                    <button class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Xác nhận đã giao</button>
                                </form>
                            }
                        </div>
                    </div></div>
                </div>
                }
                <!-- Popup xóa vận đơn đã giao -->
                @if (duocTao && v.TrangThai == "DA_GIAO")
                {
                <div class="modal fade" id="xoa-@v.MaVanDon" tabindex="-1">
                    <div class="modal-dialog"><div class="modal-content">
                        <div class="modal-header"><h6 class="modal-title">Xóa vận đơn @v.MaCodeVanDon?</h6><button class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
                        <form asp-action="Xoa" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@v.MaVanDon" />
                            <div class="modal-body"><p class="mb-0">Chỉ dọn bản ghi vận chuyển, đơn hàng vẫn giữ <b>hoàn tất</b>.</p></div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                            </div>
                        </form>
                    </div></div>
                </div>
                }
            }
            @if (!Model.Any()) { <tr><td colspan="7"><div class="empty-state"><i class="bi bi-truck"></i><div>Chưa có vận đơn (đơn GIAO_HANG sẽ tự tạo vận đơn)</div><a asp-controller="DonHang" asp-action="Create" class="btn btn-sm btn-primary">Tạo đơn giao hàng</a></div></td></tr> }
            </tbody>
        </table>
    </div>
</div>


