@model QuanLyKhoWeb.Models.ViewModels.NhanVienEditVm
@{
    ViewData["Title"] = "Sửa hồ sơ nhân viên";
}
<div class="page-header">
    <div><h3 class="app-page-title"><i class="bi bi-pencil me-2 text-primary"></i>Sửa hồ sơ: @Model.HoTen</h3><p class="page-subtitle">Vai trò và trạng thái sửa riêng ở trang chi tiết</p></div>
    <a asp-action="Details" asp-route-id="@Model.MaNguoiDung" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
</div>
<div class="app-card" style="max-width:720px">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.MaNguoiDung" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="HoTen" class="form-label required"></label><input asp-for="HoTen" class="form-control" pattern="[^0-9]*" title="Họ tên không được chứa số" /><span asp-validation-for="HoTen" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="SoDienThoai" class="form-label">Số điện thoại</label><input asp-for="SoDienThoai" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Cccd" class="form-label"></label><input asp-for="Cccd" class="form-control" maxlength="12" inputmode="numeric" /><span asp-validation-for="Cccd" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="NgaySinh" class="form-label">Ngày sinh</label><input asp-for="NgaySinh" type="date" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="GioiTinh" class="form-label">Giới tính</label><select asp-for="GioiTinh" class="form-select"><option value="">-- Chọn --</option><option>Nam</option><option>Nữ</option><option>Khác</option></select></div>
            <div class="col-md-6"><label asp-for="ThuongTru" class="form-label">Thường trú</label><input asp-for="ThuongTru" class="form-control" /></div>
            <div class="col-md-6">
                <label asp-for="AnhTheMoi" class="form-label"></label>
                <div class="d-flex gap-2 align-items-center">
                    @if (!string.IsNullOrEmpty(Model.AnhTheHienTai))
                    { <img src="@Model.AnhTheHienTai" style="width:48px;height:64px;object-fit:cover;border-radius:8px" alt="Ảnh thẻ" /> }
                    <input asp-for="AnhTheMoi" class="form-control" accept="image/*" />
                </div>
                <span asp-validation-for="AnhTheMoi" class="text-danger"></span>
            </div>
            <div class="col-md-6"><label asp-for="StkNganHang" class="form-label"></label><input asp-for="StkNganHang" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="ChiNhanhNganHang" class="form-label"></label><input asp-for="ChiNhanhNganHang" class="form-control" /></div>
        </div>
        <div class="mt-3 d-flex gap-2"><button class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Lưu thay đổi</button><a asp-action="Details" asp-route-id="@Model.MaNguoiDung" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
