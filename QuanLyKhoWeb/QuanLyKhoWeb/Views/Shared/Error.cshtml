@model ErrorViewModel
@{
    ViewData["Title"] = "Đã có lỗi xảy ra";
}
<div class="app-card text-center" style="max-width:560px;margin:40px auto;">
    <i class="bi bi-exclamation-octagon" style="font-size:44px;color:var(--app-danger)"></i>
    <h4 class="fw-bold mt-3 mb-1">Đã có lỗi xảy ra</h4>
    <p class="text-muted mb-3">Thao tác không thực hiện được. Vui lòng thử lại, nếu vẫn lỗi hãy báo cho quản trị viên.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted" style="font-size:12.5px">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="TongQuan" asp-action="Index" class="btn btn-primary"><i class="bi bi-house me-1"></i>Về trang chủ</a>
</div>

