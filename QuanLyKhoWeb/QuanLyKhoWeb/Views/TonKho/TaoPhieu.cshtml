@{
    ViewData["Title"] = "Tạo phiếu nhập";
    var nccs = ViewBag.Nccs as List<QuanLyKhoWeb.Models.Entities.NhaCungCap> ?? new();
}
<div class="page-header">
    <div>
        <h1 class="app-page-title"><i class="bi bi-plus-lg"></i>Tạo phiếu nhập kho</h1>
        <p class="page-subtitle">Chọn hàng nhận từ nhà cung cấp. Hoàn tất phiếu sẽ cộng tồn theo số lượng thực nhận.</p>
    </div>
    <a asp-action="PhieuNhap" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i>Quay lại</a>
</div>
<div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

<form asp-action="TaoPhieu" method="post" id="frmNhap" class="form-layout">
    @Html.AntiForgeryToken()
    <div class="form-main">
        <div class="form-block">
            <h6 class="section-title"><i class="bi bi-box-seam"></i>Dòng hàng <span class="text-muted fw-normal" style="font-weight:400">— cần ít nhất một</span></h6>
            <div class="position-relative mb-3">
                <input id="txtSku" class="form-control" placeholder="Tìm SKU hoặc tên sản phẩm để thêm…" autocomplete="off" />
                <div id="kqSku" class="list-group position-absolute w-100" style="z-index:10"></div>
            </div>
            <div class="table-responsive">
                <table class="table table-app" id="tblItems">
                    <thead><tr><th>Sản phẩm</th><th style="width:110px">SL kế hoạch</th><th style="width:110px">SL thực nhận</th><th style="width:150px">Đơn giá nhập</th><th></th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
            <span class="text-danger">@if (ViewData.ModelState.TryGetValue("SoLuongKeHoaches", out var loiSl) && loiSl.Errors.Count > 0) { @loiSl.Errors[0].ErrorMessage }</span>
            <div class="form-hint">Số lượng thực nhận là số được cộng vào kho khi hoàn tất phiếu.</div>
        </div>
    </div>

    <aside class="form-aside">
        <div class="summary-card">
            <div class="summary-head"><i class="bi bi-receipt"></i>Thông tin phiếu</div>
            <div class="summary-body">
                <div>
                    <label class="form-label">Mã phiếu</label>
                    <input class="form-control" value="Tự động sinh sau khi lưu" readonly />
                </div>
                <div>
                    <label class="form-label required">Nhà cung cấp</label>
                    @if (nccs.Count == 0)
                    {
                        <div class="alert alert-warning py-2 px-3 mb-2" role="alert" id="canhBaoNcc">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Chưa có nhà cung cấp nào đang hoạt động.</strong>
                            <div class="small mt-1">Phiếu nhập bắt buộc phải chọn nhà cung cấp. Vui lòng vào
                                <a asp-controller="NhaCungCap" asp-action="Create" class="alert-link">Nhà cung cấp</a>
                                để thêm mới, hoặc bật lại một nhà cung cấp đang tạm ngưng, rồi quay lại tạo phiếu.</div>
                        </div>
                    }
                    <select name="maNhaCungCap" class="form-select" required id="selNcc" disabled="@(nccs.Count == 0 ? "disabled" : null)">
                        <option value="">@(nccs.Count == 0 ? "Chưa có nhà cung cấp đang hoạt động" : "Chọn nhà cung cấp")</option>
                        @foreach (var n in nccs) { <option value="@n.MaNhaCungCap">@n.MaCodeNcc — @n.TenNhaCungCap</option> }
                    </select>
                </div>
                <div>
                    <label class="form-label">Ghi chú</label>
                    <textarea name="ghiChu" class="form-control" rows="2"></textarea>
                </div>
                <div class="summary-total">
                    <span>Tạm tính</span>
                    <strong id="tamTinh">0 đ</strong>
                </div>
            </div>
            <div class="summary-actions">
                <button class="btn btn-primary w-100" name="luuNhap" value="false" disabled="@(nccs.Count == 0 ? "disabled" : null)"><i class="bi bi-check2"></i>Tạo &amp; hoàn tất</button>
                <button class="btn btn-outline-primary w-100" name="luuNhap" value="true" disabled="@(nccs.Count == 0 ? "disabled" : null)"><i class="bi bi-save"></i>Lưu nháp</button>
                <a asp-action="PhieuNhap" class="btn btn-outline-secondary w-100">Hủy</a>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-body">
                <div class="summary-note"><i class="bi bi-info-circle"></i><span><b>Tạo &amp; hoàn tất</b> cộng tồn ngay theo số thực nhận. <b>Lưu nháp</b> giữ phiếu ở trạng thái chờ để kiểm hàng, sau đó bấm Hoàn tất phiếu ở trang chi tiết.</span></div>
            </div>
        </div>
    </aside>
</form>

@section Scripts {
<script>
let items = [];
const fmt = n => n.toLocaleString('vi-VN') + ' đ';
const txt = document.getElementById('txtSku'), kq = document.getElementById('kqSku');
async function taiList(term) {
  const res = await fetch('/TonKho/TimSku?term=' + encodeURIComponent(term));
  return await res.json();
}
txt.addEventListener('focus', async () => { veList(await taiList('')); });
txt.addEventListener('input', async () => {
  const t = txt.value.trim();
  if (!t) { veList(await taiList('')); return; }
  const res = await fetch('/TonKho/TimSku?term=' + encodeURIComponent(t));
  veList(await res.json());
});
function veList(list) {
  kq.innerHTML = '';
  if (list.length === 0) { kq.innerHTML = '<span class="list-group-item text-muted">Không tìm thấy món nào</span>'; return; }
  list.forEach(sp => {
    const b = document.createElement('button');
    b.type='button'; b.className='list-group-item list-group-item-action';
    b.textContent = `${sp.ten} (${sp.maCodeSku}) — tồn ${sp.ton}`;
    b.onclick = () => { themDong(sp); kq.innerHTML=''; txt.value=''; };
    kq.appendChild(b);
  });
}
function themDong(sp) {
  if (items.find(x => x.maSku === sp.maSku)) return;
  items.push({...sp, slKh: 0, slTn: 0, dg: 0});
  render();
}
// Chỉ dựng lại bảng khi thêm/xóa dòng. Khi sửa số lượng/đơn giá chỉ cập nhật
// mô hình + tạm tính, KHÔNG thay thế input đang thao tác (trước đây render() lại
// toàn bộ tbody trong onchange làm cú click đầu tiên bị mất focus).
function capNhatTong() {
  let tong = 0;
  items.forEach(it => { tong += (it.dg || 0) * (it.slTn || 0); });
  document.getElementById('tamTinh').textContent = fmt(tong);
}
function render() {
  const tb = document.querySelector('#tblItems tbody');
  tb.innerHTML = '';
  if (items.length === 0) {
    tb.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">Chưa có dòng hàng. Tìm và chọn sản phẩm ở ô phía trên.</td></tr>';
    document.getElementById('tamTinh').textContent = fmt(0);
    return;
  }
  items.forEach((it, idx) => {
    const tr = document.createElement('tr');
    // Ô đơn giá dùng .money của site.js; hiển thị sẵn dấu phân cách nghìn.
    const dgHienThi = it.dg ? it.dg.toLocaleString('vi-VN') : '';
    tr.innerHTML = `<td><div class="cell-main">${it.ten}</div><div class="cell-sub">${it.maCodeSku}</div>
      <input type="hidden" name="MaSkus" value="${it.maSku}"/></td>
      <td><input type="number" name="SoLuongKeHoaches" value="${it.slKh}" min="0" step="1" class="form-control form-control-sm" onchange="doiKh(${idx}, this.value, this)"/></td>
      <td><input type="number" name="SoLuongThucNhans" value="${it.slTn}" min="0" step="1" class="form-control form-control-sm" onchange="doiTn(${idx}, this.value, this)"/></td>
      <td><input type="text" inputmode="numeric" name="DonGiaNhaps" value="${dgHienThi}" class="form-control form-control-sm money" onchange="doiDg(${idx}, this.value, this)"/></td>
      <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="xoaDong(${idx})" aria-label="Bỏ dòng hàng"><i class="bi bi-trash"></i></button></td>`;
    tb.appendChild(tr);
  });
  capNhatTong();
}
window.doiKh = (i, v, el) => {
  const n = Math.max(0, parseInt(v) || 0);
  items[i].slKh = n;
  if (el && el.value !== String(n)) el.value = n;
  capNhatTong();
};
window.doiTn = (i, v, el) => {
  const n = Math.max(0, parseInt(v) || 0);
  items[i].slTn = n;
  if (el && el.value !== String(n)) el.value = n;
  capNhatTong();
};
window.doiDg = (i, v, el) => {
  const n = Math.max(0, parseInt(String(v).replace(/\./g, '')) || 0);
  items[i].dg = n;
  const hienThi = n ? n.toLocaleString('vi-VN') : '';
  if (el && el.value !== hienThi) el.value = hienThi;
  capNhatTong();
};
window.xoaDong = i => { items.splice(i,1); render(); };
render();
</script>
}
