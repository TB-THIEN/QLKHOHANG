@model List<dynamic>
@{
    ViewData["Title"] = "Top sản phẩm bán chạy";
    var boLoc = (ViewBag.BoLoc as string) ?? "TAT_CA";
    var nhanBoLoc = new Dictionary<string, string>
    {
        ["TAT_CA"] = "Tất cả",
        ["NGAY"] = "Hôm nay",
        ["THANG"] = "Tháng này",
        ["NAM"] = "Năm nay",
        ["TUY_CHON"] = "Tùy chỉnh"
    };
}
<div class="page-header">
    <div>
        <h1 class="app-page-title"><i class="bi bi-trophy"></i>Top sản phẩm bán chạy</h1>
        <p class="page-subtitle">Xếp hạng theo số lượng bán trong kỳ lọc.</p>
    </div>
    <a asp-controller="BaoCao" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i>Về báo cáo</a>
</div>

<div class="app-card mb-3">
    <h6 class="section-title"><i class="bi bi-funnel"></i>Bộ lọc</h6>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-6 col-md-3">
            <label class="form-label">Khoảng thời gian</label>
            <select name="boLoc" class="form-select">
                @foreach (var o in new[] { "TAT_CA", "NGAY", "THANG", "NAM", "TUY_CHON" })
                {
                    @if (boLoc == o) { <option value="@o" selected>@nhanBoLoc[o]</option> } else { <option value="@o">@nhanBoLoc[o]</option> }
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label">Từ ngày</label>
            <input type="date" name="tuNgay" value="@ViewBag.TuNgay" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label">Đến ngày</label>
            <input type="date" name="denNgay" value="@ViewBag.DenNgay" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <button class="btn btn-primary w-100"><i class="bi bi-search"></i>Lọc</button>
        </div>
    </form>
</div>

<div class="app-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h6 class="section-title mb-0" style="border-left-color:var(--kho-primary)"><i class="bi bi-table"></i>Bảng xếp hạng</h6>
        <span class="cell-sub">@Model.Count sản phẩm</span>
    </div>
    <div class="table-responsive">
        <table class="table table-app mb-0">
            <thead><tr><th style="width:56px">Hạng</th><th>Ảnh</th><th>Sản phẩm</th><th class="num">SL bán</th><th class="num">Doanh thu</th></tr></thead>
            <tbody>
            @{ int i = 0; }
            @foreach (var r in Model)
            {
                i++;
                string? hinh = r.duong_dan_hinh_anh;
                <tr>
                    <td>
                        @if (i <= 3) { <span class="sku" style="font-weight:600">@i</span> }
                        else { <span class="cell-sub">@i</span> }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(hinh)) { <img src="@hinh" class="thumb-44" alt="" loading="lazy" /> }
                        else { <span class="text-muted"><i class="bi bi-image" style="font-size:22px"></i></span> }
                    </td>
                    <td>
                        <div class="cell-main">@r.ten_san_pham</div>
                        <div class="cell-sub">@r.ma_code_sku</div>
                    </td>
                    <td class="num fw-semibold">@r.tong_so_luong_ban</td>
                    <td class="num">@(((decimal)r.tong_doanh_thu).ToString("N0")) đ</td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5">
                    <div class="empty-state">
                        <i class="bi bi-trophy"></i>
                        <div>Chưa có dữ liệu bán hàng</div>
                        <p class="page-subtitle mx-auto" style="max-width:42ch">Chọn khoảng thời gian khác, hoặc tạo đơn hàng đầu tiên.</p>
                    </div>
                </td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
