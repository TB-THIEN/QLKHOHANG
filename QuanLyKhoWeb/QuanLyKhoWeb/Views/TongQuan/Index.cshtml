@{
    ViewData["Title"] = "Tổng quan";
    ViewData["Subtitle"] = "Tình hình kho và đơn hàng theo ngày";
    var donHomNay = (int)(ViewBag.DonHomNay ?? 0);
    var doanhThu = (decimal)(ViewBag.DoanhThuHomNay ?? (decimal)0);
    var tongTon = (int)(ViewBag.TongTonKho ?? 0);
    var sapHet = (int)(ViewBag.SanPhamSapHet ?? 0);
    var donMoi = ViewBag.DonMoiNhat as List<QuanLyKhoWeb.Models.Entities.DonHang> ?? new();
    var ngayXem = (ViewBag.NgayXem as string) ?? "";
    var ngayXemHienThi = (ViewBag.NgayXemHienThi as string) ?? "";
}
<div class="page-header">
    <div><h3 class="app-page-title">Tổng quan</h3><p class="page-subtitle">Tình hình kho và đơn hàng ngày @ngayXemHienThi</p></div>
    <div class="d-flex gap-2 align-items-end flex-wrap">
        <form method="get" class="d-flex gap-2 align-items-end">
            <div><label class="form-label mb-0"><small>Xem đơn ngày</small></label><input type="date" name="ngay" value="@ngayXem" class="form-control form-control-sm" onchange="this.form.submit()" /></div>
        </form>
        <a asp-controller="DonHang" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Tạo đơn</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="stat-card"><div class="stat-icon" style="background:linear-gradient(135deg,#0088ff,#00c6ff)"><i class="bi bi-receipt"></i></div>
        <div><div class="stat-label">Đơn ngày @ngayXemHienThi</div><div class="stat-value">@donHomNay</div></div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card"><div class="stat-icon" style="background:linear-gradient(135deg,#00b14f,#4bd980)"><i class="bi bi-cash-stack"></i></div>
        <div><div class="stat-label">Doanh thu ngày @ngayXemHienThi</div><div class="stat-value">@doanhThu.ToString("N0") đ</div></div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card"><div class="stat-icon" style="background:linear-gradient(135deg,#ff9017,#ffbd59)"><i class="bi bi-boxes"></i></div>
        <div><div class="stat-label">Tổng tồn kho</div><div class="stat-value">@tongTon</div></div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card"><div class="stat-icon" style="background:linear-gradient(135deg,#f04438,#ff7a6e)"><i class="bi bi-exclamation-triangle"></i></div>
        <div><div class="stat-label">Sắp hết hàng (≤5)</div><div class="stat-value">@sapHet</div></div></div>
    </div>
</div>

<div class="app-card">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <h6 class="fw-bold mb-0"><i class="bi bi-clock-history me-1 text-primary"></i>Đơn hàng ngày @ngayXemHienThi</h6>
        <a asp-controller="DonHang" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả<i class="bi bi-arrow-right ms-1"></i></a>
    </div>
    <div class="table-responsive">
        <table class="table table-app table-hover mb-0">
            <thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th class="num">Tổng tiền</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var d in donMoi)
            {
                <tr>
                    <td class="fw-bold"><a asp-controller="DonHang" asp-action="Details" asp-route-id="@d.MaDonHang" class="text-decoration-none">@d.MaCodeDonHang</a></td>
                    <td>@d.NgayDatHang?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="num fw-bold">@d.ThanhTien.ToString("N0") đ</td>
                    <td>
                        @if (d.TrangThai == "CANCELLED") { <span class="badge bg-secondary">Đã hủy</span> }
                        else if (d.TrangThai == "COMPLETED") { <span class="badge bg-success">Hoàn tất</span> }
                        else { <span class="badge bg-info">Đã xác nhận</span> }
                    </td>
                </tr>
            }
            @if (!donMoi.Any()) { <tr><td colspan="4"><div class="empty-state"><i class="bi bi-receipt"></i><div>Chưa có đơn hàng nào</div><a asp-controller="DonHang" asp-action="Create" class="btn btn-sm btn-primary">Tạo đơn đầu tiên</a></div></td></tr> }
            </tbody>
        </table>
    </div>
</div>

