@{
    ViewData["Title"] = "Tổng quan";
    ViewData["Subtitle"] = "Tình hình kho và đơn hàng theo ngày";
    var donHomNay = (int)(ViewBag.DonHomNay ?? 0);
    var doanhThu = (decimal)(ViewBag.DoanhThuHomNay ?? (decimal)0);
    var tongTon = (int)(ViewBag.TongTonKho ?? 0);
    var sapHet = (int)(ViewBag.SanPhamSapHet ?? 0);
    var donMoi = ViewBag.DonMoiNhat as List<QuanLyKhoWeb.Models.Entities.DonHang> ?? new();
    var ngayXem = (ViewBag.NgayXem as string) ?? "";
    var ngayXemHienThi = (ViewBag.NgayXemHienThi as string) ?? "";
}
<div class="page-header">
    <div>
        <h1 class="app-page-title">Tổng quan</h1>
        <p class="page-subtitle">Tình hình kho và đơn hàng ngày @ngayXemHienThi.</p>
    </div>
    <div class="d-flex gap-2 align-items-end flex-wrap">
        <form method="get" class="d-flex gap-2 align-items-end">
            <div><label class="form-label mb-0">Xem đơn ngày</label><input type="date" name="ngay" value="@ngayXem" class="form-control form-control-sm" onchange="this.form.submit()" /></div>
        </form>
        <a asp-controller="DonHang" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i>Tạo đơn</a>
    </div>
</div>

<div class="app-card mb-3">
    <h6 class="section-title"><i class="bi bi-search"></i>Tìm đơn trong ngày</h6>
    <partial name="_OTimKiem" model="@(new QuanLyKhoWeb.Models.ViewModels.OTimKiemVm {
        Trang = "tongquan",
        Controller = "TongQuan",
        GiaTri = ViewData["SearchValue"] as string,
        Placeholder = "Tìm mã đơn, tên khách, số điện thoại…",
        ThamSoThem = new() { ["ngay"] = ngayXem }
    })" />
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-receipt"></i></div>
            <div><div class="stat-value">@donHomNay</div><div class="stat-label">Đơn ngày @ngayXemHienThi</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card stat-success">
            <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
            <div><div class="stat-value">@doanhThu.ToString("N0") đ</div><div class="stat-label">Doanh thu ngày @ngayXemHienThi</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card stat-warning">
            <div class="stat-icon"><i class="bi bi-boxes"></i></div>
            <div><div class="stat-value">@tongTon</div><div class="stat-label">Tổng tồn kho</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card stat-danger">
            <div class="stat-icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div><div class="stat-value">@sapHet</div><div class="stat-label">Sắp hết hàng (≤ 5)</div></div>
        </div>
    </div>
</div>

<div class="app-card">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <h6 class="section-title mb-0" style="border-left-color:var(--kho-primary)"><i class="bi bi-clock-history"></i>Đơn hàng ngày @ngayXemHienThi</h6>
        <a asp-controller="DonHang" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả đơn</a>
    </div>
    <div class="table-responsive">
        <table class="table table-app mb-0">
            <thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th class="num">Tổng tiền</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var d in donMoi)
            {
                <tr>
                    <td><a asp-controller="DonHang" asp-action="Details" asp-route-id="@d.MaDonHang" class="sku text-decoration-none">@d.MaCodeDonHang</a></td>
                    <td class="cell-sub">@d.NgayDatHang?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="num fw-semibold">@d.ThanhTien.ToString("N0") đ</td>
                    <td>
                        @if (d.TrangThai == "CANCELLED") { <span class="badge bg-secondary badge-dot">Đã hủy</span> }
                        else if (d.TrangThai == "COMPLETED") { <span class="badge bg-success badge-dot">Hoàn tất</span> }
                        else { <span class="badge bg-info badge-dot">Đã xác nhận</span> }
                    </td>
                </tr>
            }
            @if (!donMoi.Any())
            {
                <tr><td colspan="4">
                    <div class="empty-state">
                        <i class="bi bi-receipt"></i>
                        <div>Chưa có đơn hàng trong ngày</div>
                        <a asp-controller="DonHang" asp-action="Create" class="btn btn-primary">Tạo đơn hàng</a>
                    </div>
                </td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
