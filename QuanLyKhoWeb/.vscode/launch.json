{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chạy web Kho Hàng (tự mở trình duyệt)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/QuanLyKhoWeb/bin/Debug/net10.0/QuanLyKhoWeb.dll",
      "args": [],
      "cwd": "${workspaceFolder}/QuanLyKhoWeb",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5213"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/Account/DangNhap"
      }
    }
  ]
}
